{
  "version": 1,
  "idle": {
    "screensaver": 150,
    "lock": 300
  },
  "bar": {
    "position": "top",
    "transparent": false,
    "glass": true,
    "centerAnchor": "neko.unibar-center",
    "layout": {
      "left": [
        {
          "id": "neko.system-monitor"
        },
        {
          "id": "neko.active-window"
        }
      ],
      "center": [
        {
          "id": "neko.media-players",
          "group": "unibar",
          "integrated": true
        },
        {
          "id": "neko.workspace-bars-left",
          "group": "unibar",
          "start": 1
        },
        {
          "id": "neko.unibar-center",
          "group": "unibar",
          "format": "HH:mm"
        },
        {
          "id": "neko.workspace-bars-right",
          "group": "unibar",
          "start": 6
        },
        {
          "id": "neko.pomodoro",
          "group": "unibar",
          "integrated": true
        }
      ],
      "right": [
        {
          "id": "neko.keyboard-layout",
          "group": "status"
        },
        {
          "id": "neko.tray",
          "group": "status"
        },
        {
          "id": "neko.agents",
          "group": "status"
        },
        {
          "id": "neko.bluetooth",
          "group": "status"
        },
        {
          "id": "neko.network",
          "group": "status"
        },
        {
          "id": "neko.audio",
          "group": "status"
        },
        {
          "id": "neko.power",
          "group": "status"
        },
        {
          "id": "neko.control-center",
          "hideButton": true
        }
      ]
    },
    "style": "attached"
  },
  "plugins": []
}
