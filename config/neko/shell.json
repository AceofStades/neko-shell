{
  "version": 1,
  "idle": {
    "screensaver": 150,
    "lock": 300
  },
  "bar": {
    "position": "top",
    "transparent": false,
    "glass": true,
    "centerAnchor": "neko.workspaces",
    "layout": {
      "left": [
        {
          "id": "neko.system-monitor"
        },
        {
          "id": "neko.active-window"
        }
      ],
      "center": [
        {
          "id": "neko.media-players"
        },
        {
          "id": "neko.workspaces"
        },
        {
          "id": "neko.pomodoro"
        }
      ],
      "right": [
        {
          "id": "neko.keyboard-layout",
          "group": "status"
        },
        {
          "id": "neko.tray",
          "group": "status"
        },
        {
          "id": "neko.agents",
          "group": "status"
        },
        {
          "id": "neko.bluetooth",
          "group": "status"
        },
        {
          "id": "neko.network",
          "group": "status"
        },
        {
          "id": "neko.audio",
          "group": "status"
        },
        {
          "id": "neko.power",
          "group": "status"
        },
        {
          "id": "neko.control-center",
          "hideButton": true
        },
        {
          "id": "neko.clock",
          "format": "dddd HH:mm",
          "formatAlt": "d MMMM 'W'ww yyyy",
          "verticalFormat": "HH\n—\nmm"
        }
      ]
    },
    "style": "attached"
  },
  "plugins": []
}
