#!/bin/bash

# neko:summary=Print a line each time Howdy looks for a face, and how it went
# neko:args=
# neko:hidden=true

# neko-core's faceauth-watch (core/), or, until that's built, the Python
# version it replaces (legacy/)
root=$(cd "$(dirname "$(readlink -f "$0")")/.." && pwd)
if [[ -x $root/core/target/release/neko-core ]]; then
  exec "$root/core/target/release/neko-core" faceauth-watch "$@"
fi
exec "$root/legacy/neko-faceauth-watch" "$@"
