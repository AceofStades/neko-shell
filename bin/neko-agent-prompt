#!/bin/bash

# neko:summary=Launch the default coding agent with a prompt
# neko:args=[--inline] <prompt...>
# neko:examples=neko agent prompt "Review this project"

# Prompts live here rather than on `neko agent`, where a bare prompt would
# shadow the subcommands under that group.

set -euo pipefail

inline=()
if [[ ${1:-} == "--inline" ]]; then
  inline=(--inline)
  shift
fi

if (($# == 0)); then
  echo "Usage: neko agent prompt [--inline] <prompt...>" >&2
  exit 1
fi

exec neko-agent "${inline[@]}" --prompt "$*"
