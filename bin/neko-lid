#!/bin/bash

# neko:summary=Turn the laptop screen off while the lid is closed, and keep the laptop working with it closed if asked
# neko:args=apply | awake [on|off|toggle|status]

# Suspend stays logind's job: with the default HandleLidSwitch it suspends on
# lid close unless an external display is connected (docked), and suspends
# when the last one is unplugged with the lid shut. This only decides whether
# the laptop panel should be on, from the lid and the monitors right now, so
# running it again is always safe. Turning the panel back on reloads the
# Hyprland config, which re-applies your own rule for it (mode, position,
# scale) instead of guessing one.

# Kept awake, the lid switch is held by a block of logind's (a user unit,
# neko-lid-awake, so it lasts until turned off or the session ends): closing
# the lid only turns the laptop screen off, and the laptop keeps working.
AWAKE_UNIT=neko-lid-awake

awake_on() {
  systemctl --user is-active --quiet "$AWAKE_UNIT.service" && return 0
  systemd-run --user --quiet --collect --unit="$AWAKE_UNIT" \
    systemd-inhibit --what=handle-lid-switch --who=neko --why="Keep working with the lid closed" --mode=block sleep infinity
}

awake_off() {
  systemctl --user stop "$AWAKE_UNIT.service" 2> /dev/null
  return 0
}

if [[ $1 == "awake" ]]; then
  case ${2:-status} in
    on) awake_on ;;
    off) awake_off ;;
    toggle) if systemctl --user is-active --quiet "$AWAKE_UNIT.service"; then awake_off; else awake_on; fi ;;
    status) systemctl --user is-active --quiet "$AWAKE_UNIT.service" && echo on || echo off ;;
    *) echo "Usage: neko-lid awake [on|off|toggle|status]" >&2; exit 1 ;;
  esac
  exit
fi

if [[ $1 != "apply" ]]; then
  echo "Usage: neko-lid apply | awake [on|off|toggle|status]" >&2
  exit 1
fi

monitors=$(hyprctl monitors all -j) || exit 0
internal=$(jq -r '[.[] | select(.name | test("^(eDP|LVDS|DSI)"))][0].name // empty' <<< "$monitors")

# The name goes into Lua below, so only ever a plain connector name
if [[ -z $internal || ! $internal =~ ^[A-Za-z0-9._-]+$ ]]; then
  exit 0
fi

lid_closed=false
if grep -qis closed /proc/acpi/button/lid/*/state; then
  lid_closed=true
fi

externals=$(jq --arg internal "$internal" '[.[] | select(.name != $internal and .disabled != true)] | length' <<< "$monitors")
internal_disabled=$(jq -r --arg internal "$internal" '.[] | select(.name == $internal) | .disabled' <<< "$monitors")

if [[ $lid_closed == true ]] && (( externals > 0 )); then
  if [[ $internal_disabled != "true" ]]; then
    hyprctl eval "hl.monitor({ output = \"$internal\", disabled = true })" > /dev/null
  fi
elif [[ $lid_closed == true ]] && systemctl --user is-active --quiet "$AWAKE_UNIT.service"; then
  # Working with the lid shut and no other screen: the panel only goes dark
  hyprctl dispatch "hl.dsp.dpms({ action = \"disable\", monitor = \"$internal\" })" > /dev/null
elif [[ $lid_closed == false && $internal_disabled == "true" ]]; then
  hyprctl reload > /dev/null
fi
