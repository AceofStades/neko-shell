#!/bin/bash

# neko:summary=Apply the current theme keyboard color to Framework Laptop 16 keyboards
# neko:hidden=true

FRAMEWORK16_THEME=$HOME/.local/state/neko/current/theme/keyboard.rgb

if neko-cmd-present qmk_hid && [[ -f $FRAMEWORK16_THEME ]]; then
  hex=$(cat "$FRAMEWORK16_THEME")
  hex="${hex#\#}"

  [[ $hex =~ ^[0-9A-Fa-f]{6}$ ]] || exit 0

  # Hex to QMK's hue and saturation (0-255), the way colorsys.rgb_to_hsv does
  read -r h s < <(awk -v hex="$hex" 'BEGIN {
    r = strtonum("0x" substr(hex, 1, 2)) / 255
    g = strtonum("0x" substr(hex, 3, 2)) / 255
    b = strtonum("0x" substr(hex, 5, 2)) / 255
    max = r; if (g > max) max = g; if (b > max) max = b
    min = r; if (g < min) min = g; if (b < min) min = b
    h = 0; s = 0
    if (max != min) {
      s = (max - min) / max
      rc = (max - r) / (max - min); gc = (max - g) / (max - min); bc = (max - b) / (max - min)
      if (r == max) h = bc - gc; else if (g == max) h = 2.0 + rc - bc; else h = 4.0 + gc - rc
      h = h / 6.0; h = h - int(h); if (h < 0) h += 1.0
    }
    printf "%d %d\n", int(h * 255), int(s * 255)
  }')

  qmk_hid via --rgb-effect 1 2>/dev/null
  qmk_hid via --rgb-hue "$h" 2>/dev/null
  qmk_hid via --rgb-saturation "$s" 2>/dev/null
  qmk_hid via --rgb-brightness 100 2>/dev/null
  qmk_hid via --save 2>/dev/null
fi
