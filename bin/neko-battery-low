#!/bin/bash

# neko:summary=Send the low battery warning notification and run battery-low hooks.
# neko:args=<percentage>
# neko:hidden=true

set -euo pipefail

if (($# != 1)); then
  echo "Usage: neko-battery-low <percentage>" >&2
  exit 1
fi

level=$1

neko-notification-send -g 󱐋 -u critical "Time to recharge!" "Battery is down to ${level}%" -i battery-caution -t 30000
neko-hook battery-low "$level"
