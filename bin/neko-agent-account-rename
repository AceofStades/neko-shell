#!/bin/bash

# neko:summary=Rename a Claude, Codex, or Grok subscription account
# neko:args=[claude|codex|grok] <account> <name>
# neko:examples=neko agent account rename primary Hey | neko agent account rename codex side Side project

set -uo pipefail

# The provider can be left out when it's your default agent:
# `neko agent account rename primary Hey`.
if [[ ${1:-} != "claude" && ${1:-} != "codex" && ${1:-} != "grok" ]]; then
  default=$(neko-default-agent)
  [[ $default == "claude" || $default == "codex" || $default == "grok" ]] && set -- "$default" "$@"
fi

if [[ ${1:-} != "claude" && ${1:-} != "codex" && ${1:-} != "grok" ]] || (( $# < 3 )); then
  echo "Usage: neko-agent-account-rename [claude|codex|grok] <account> <name>" >&2
  exit 1
fi

account=$(neko-agent-account-state rename "$@") || exit 1
echo "Renamed to $(jq -r .label <<<"$account"). Switch to it with: neko agent account use $(jq -r .id <<<"$account")"
# The panel reads account names from the usage record.
neko-agent-usage-update --limits-only "$1" >/dev/null 2>&1 &
