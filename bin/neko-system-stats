#!/bin/bash

# neko:summary=Print CPU and memory stats for the shell
# neko:group=system
# neko:args=[--bar-widget|--cpu-temperature-file|--details|--gpu]

bar_widget_stats() {
  awk '
    NR == 1 {
      idle = $5
      total = 0
      for (i = 2; i <= NF; i++) total += $i
      printf "cpu\t%s\t%s\n", idle, total
    }
  ' /proc/stat

  awk '
    /^MemTotal:/ { total = $2 }
    /^MemAvailable:/ { avail = $2 }
    END {
      if (total > 0) printf "memory\t%.2f\n", ((total - avail) / total) * 100
    }
  ' /proc/meminfo

  awk '{ print "load\t" $1 }' /proc/loadavg
}

# The file with the CPU's temperature in millidegrees: the package sensor
# (Intel coretemp, AMD k10temp or zenpower), else the package thermal zone,
# else the first zone. hwmon numbers change between boots, so look it up.
cpu_temperature_file() {
  local hwmon zone
  for hwmon in /sys/class/hwmon/hwmon*; do
    if [[ $(< "$hwmon/name") =~ ^(coretemp|k10temp|zenpower)$ && -r $hwmon/temp1_input ]]; then
      echo "$hwmon/temp1_input"
      return
    fi
  done
  for zone in /sys/class/thermal/thermal_zone*; do
    if [[ $(< "$zone/type") == "x86_pkg_temp" ]]; then
      echo "$zone/temp"
      return
    fi
  done
  [[ -r /sys/class/thermal/thermal_zone0/temp ]] && echo /sys/class/thermal/thermal_zone0/temp
}

# Everything the system monitor panel shows, as one JSON object. CPU, disk
# and network figures are counters (the panel takes the difference between
# two reads); the busiest processes come from a second top sample, so their
# use is the current one rather than since they started (kernel threads, with
# no memory of their own, left out).
details() {
  local cpus freqs temps memory disks network power gpu procs
  cpus=$(awk '/^cpu/ { idle = $5 + $6; total = 0; for (i = 2; i <= NF; i++) total += $i; printf "%s[%d,%d]", (n++ ? "," : "["), idle, total } END { print "]" }' /proc/stat)
  local i
  freqs=$(for (( i = 0; i < $(nproc --all); i++ )); do
    cat "/sys/devices/system/cpu/cpu$i/cpufreq/scaling_cur_freq" 2> /dev/null || echo 0
  done | jq -sc 'map(. / 1000 | round)')

  local hwmon input name label
  temps=$(
    for hwmon in /sys/class/hwmon/hwmon*; do
      name=$(< "$hwmon/name")
      for input in "$hwmon"/temp*_input; do
        [[ -r $input ]] || continue
        label=""
        [[ -r ${input%_input}_label ]] && label=$(< "${input%_input}_label")
        printf '%s\t%s\t%s\n' "$name" "$label" "$(< "$input")"
      done
    done | jq -Rsc 'split("\n") | map(select(. != "") | split("\t") | { sensor: .[0], label: .[1], value: (.[2] | tonumber / 1000) })'
  )

  memory=$(awk '/^(MemTotal|MemAvailable|MemFree|Buffers|Cached|SReclaimable|Shmem|SwapTotal|SwapFree):/ { gsub(":", "", $1); printf "%s\"%s\":%d", (n++ ? "," : "{"), $1, $2 } END { print "}" }' /proc/meminfo)

  # One line per filesystem: btrfs subvolumes share their partition's figures
  disks=$(df -B1 --output=source,target,size,used -x tmpfs -x devtmpfs -x efivarfs -x overlay -x squashfs 2> /dev/null |
    awk 'NR > 1 && !seen[$1]++ { printf "%s\t%s\t%s\n", $2, $3, $4 }' |
    jq -Rsc 'split("\n") | map(select(. != "") | split("\t") | { mount: .[0], size: (.[1] | tonumber), used: (.[2] | tonumber) })')

  network=$(awk -F'[: ]+' 'NR > 2 && $2 != "lo" { rx += $3; tx += $11 } END { printf "{\"rx\":%d,\"tx\":%d}", rx, tx }' /proc/net/dev)

  power=null
  [[ -r /sys/class/power_supply/BAT0/power_now ]] && power=$(awk '{ printf "%.2f", $1 / 1000000 }' /sys/class/power_supply/BAT0/power_now)
  gpu=$(gpu_stats)

  procs=$(top -bn2 -d 0.4 -o %CPU -w 512 2> /dev/null |
    awk '/^ *PID/ { frame++; next } frame == 2 && n < 6 && $12 != "top" && $5 != 0 { cmd = $12; for (i = 13; i <= NF; i++) cmd = cmd " " $i; printf "%s\t%s\t%s\t%s\n", $1, $9, $10, cmd; n++ }' |
    jq -Rsc 'split("\n") | map(select(. != "") | split("\t") | { pid: (.[0] | tonumber), cpu: (.[1] | tonumber), memory: (.[2] | tonumber), name: .[3] })')

  jq -nc --argjson cpus "$cpus" --argjson freqs "${freqs:-[]}" --argjson temps "${temps:-[]}" --argjson memory "$memory" \
    --argjson disks "${disks:-[]}" --argjson network "$network" --argjson power "$power" --argjson gpu "$gpu" --argjson procs "${procs:-[]}" \
    --arg load "$(< /proc/loadavg)" --arg uptime "$(< /proc/uptime)" '
    { cpus: $cpus, freqs: $freqs, temps: $temps, memory: $memory, disks: $disks, network: $network,
      power: $power, gpu: $gpu, procs: $procs,
      load: ($load | split(" ")[0:3] | map(tonumber)),
      uptime: ($uptime | split(" ")[0] | tonumber | floor),
      time: (now * 1000 | floor) }'
}

# The graphics card, as one JSON object (null without one): its name, use
# (%), temperature (°C), video memory used and in all (MiB), power (W) and
# clock against its highest (MHz), each null where the card doesn't say.
# NVIDIA through nvidia-smi, AMD through its sysfs files, and Intel's
# integrated graphics, which give only their clock.
gpu_stats() {
  local line card device hwmon value
  if command -v nvidia-smi > /dev/null && line=$(nvidia-smi --query-gpu=name,utilization.gpu,temperature.gpu,memory.used,memory.total,power.draw,clocks.gr,clocks.max.gr --format=csv,noheader,nounits 2> /dev/null | head -n1) && [[ -n $line ]]; then
    jq -Rnc --arg line "$line" '
      ($line | split(", ") | map(gsub("^ +| +$"; ""))) as $f
      | def num($v): ($v | tonumber? // null);
      { name: $f[0], use: num($f[1]), temp: num($f[2]), vramUsed: num($f[3]), vramTotal: num($f[4]),
        power: num($f[5]), mhz: num($f[6]), max: num($f[7]) }'
    return
  fi
  for card in /sys/class/drm/card[0-9]; do
    device=$card/device
    if [[ -r $device/gpu_busy_percent ]]; then
      hwmon=$(ls -d "$device"/hwmon/hwmon* 2> /dev/null | head -n1)
      jq -nc \
        --arg name "$(cat "$device/product_name" 2> /dev/null || echo "AMD graphics")" \
        --arg use "$(< "$device/gpu_busy_percent")" \
        --arg temp "$(cat "$hwmon/temp1_input" 2> /dev/null)" \
        --arg used "$(cat "$device/mem_info_vram_used" 2> /dev/null)" \
        --arg total "$(cat "$device/mem_info_vram_total" 2> /dev/null)" \
        --arg power "$(cat "$hwmon/power1_average" 2> /dev/null || cat "$hwmon/power1_input" 2> /dev/null)" \
        --arg mhz "$(sed -n 's/^[0-9]*: \([0-9]*\)Mhz \*$/\1/p' "$device/pp_dpm_sclk" 2> /dev/null)" \
        --arg max "$(tail -n1 "$device/pp_dpm_sclk" 2> /dev/null | sed -n 's/^[0-9]*: \([0-9]*\)Mhz.*/\1/p')" '
        def num($v): ($v | tonumber? // null);
        { name: $name, use: num($use), temp: (num($temp) | if . then . / 1000 | round else null end),
          vramUsed: (num($used) | if . then . / 1048576 | round else null end),
          vramTotal: (num($total) | if . then . / 1048576 | round else null end),
          power: (num($power) | if . then . / 1000000 * 10 | round / 10 else null end),
          mhz: num($mhz), max: num($max) }'
      return
    fi
    if [[ -r $card/gt_cur_freq_mhz ]]; then
      jq -nc --argjson now "$(< "$card/gt_cur_freq_mhz")" --argjson max "$(< "$card/gt_max_freq_mhz")" \
        '{ name: "Intel graphics", use: null, temp: null, vramUsed: null, vramTotal: null, power: null, mhz: $now, max: $max }'
      return
    fi
  done
  echo null
}

case "${1:-}" in
  "")
    ;;
  --gpu)
    gpu_stats
    exit
    ;;
  --bar-widget)
    bar_widget_stats
    exit
    ;;
  --cpu-temperature-file)
    cpu_temperature_file
    exit
    ;;
  --details)
    details
    exit
    ;;
  *)
    echo "Usage: neko-system-stats [--bar-widget|--cpu-temperature-file|--details|--gpu]" >&2
    exit 1
    ;;
esac

cpu=$(top -bn1 | awk '/^%?Cpu/ {
  gsub(/,/, "")
  for (i = 1; i <= NF; i++) {
    if ($(i + 1) == "id") {
      printf "%.0f%%", 100 - $i
      exit
    }
  }
}')

awk -v cpu="$cpu" '
  /^MemTotal:/ { total = $2 }
  /^MemAvailable:/ { avail = $2 }
  END {
    used = total - avail
    printf "cpu\t%s\n", cpu
    printf "memory\t%.1fGB / %.0fGB\n", used / 1024 / 1024, total / 1024 / 1024
  }
' /proc/meminfo
