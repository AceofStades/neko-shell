#!/bin/bash

# neko:summary=Start or stop screen recording
# neko:group=capture
# neko:args=[--fullscreen] [--with-desktop-audio] [--with-microphone-audio] [--with-webcam] [--webcam-device=<device>] [--webcam-size=<small|medium|large>] [--stop-recording]
# neko:examples=neko screenrecord | neko capture screenrecording --with-desktop-audio
# neko:aliases=neko screenrecord
#
# The older way in to neko-record, kept for bindings that use it: stops a
# take that's going, else starts one with these choices for this take only
# (sound is off unless asked for, as it always was here).

if neko-record status | jq -e '.status != "idle"' > /dev/null; then
  exec neko-record stop
fi
[[ " $* " == *" --stop-recording "* ]] && exit 1

args=(start --set desktopAudio=off --set microphone=off --set webcam=off)
for arg in "$@"; do
  case $arg in
    --fullscreen) args+=(--monitor) ;;
    --with-desktop-audio) args+=(--set desktopAudio=on) ;;
    --with-microphone-audio) args+=(--set microphone=on) ;;
    --with-webcam) args+=(--set webcam=on) ;;
    --webcam-device=*) args+=(--set "webcamDevice=${arg#*=}") ;;
    --webcam-size=*) args+=(--set "webcamSize=${arg#*=}") ;;
  esac
done
exec neko-record "${args[@]}"
