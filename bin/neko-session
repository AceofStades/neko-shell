#!/bin/bash

# neko:summary=Start or stop neko-shell as this Hyprland session's desktop shell
# neko:args=<start|stop|theme>

# Machine-specific settings live in ~/.config/neko/env, sourced when present:
#   NEKO_QUICKSHELL  Quickshell binary to run (default: quickshell)
#   NEKO_THEME       theme from themes/ to start with (default: neko)
#   NEKO_WALLPAPER   image to use until a background has been picked
#   NEKO_REPLACES    command that stops the shell neko takes over from
#   NEKO_RESTORES    command that brings that shell back on stop

env_file=$HOME/.config/neko/env
if [[ -f $env_file ]]; then
  set -a
  source "$env_file"
  set +a
fi

export NEKO_PATH=${NEKO_PATH:-$(cd "$(dirname "$(readlink -f "$0")")/.." && pwd)}
export PATH="$NEKO_PATH/bin:$PATH"

state=$HOME/.local/state/neko/current

# The shell reads its theme from state
render_theme() {
  local theme=$(cat "$state/theme.name" 2> /dev/null)
  theme=${theme:-${NEKO_THEME:-neko}}
  rm -rf "$state/next-theme"
  mkdir -p "$state/next-theme"
  cp -r "$NEKO_PATH/themes/$theme/." "$state/next-theme/"
  neko-theme-set-templates
  rm -rf "$state/theme"
  mv "$state/next-theme" "$state/theme"
  echo "$theme" > "$state/theme.name"
}

ensure_theme() {
  if [[ ! -f $state/theme/colors.toml ]]; then
    render_theme
  fi
}

# Re-render the theme and hand it to the running shell, no restart needed
apply_theme() {
  render_theme
  neko-shell shell applyTheme "$(base64 -w 0 "$state/theme/colors.toml")" "$(base64 -w 0 "$state/theme/shell.toml")" > /dev/null
  echo "theme $(cat "$state/theme.name") applied"
}

ensure_background() {
  if [[ ! -e $state/background && -n $NEKO_WALLPAPER && -f $NEKO_WALLPAPER ]]; then
    ln -sfn "$NEKO_WALLPAPER" "$state/background"
  fi
}

# The launcher, shell and clipboard watchers started from this checkout, and
# nothing else that merely mentions it (an editor with a QML file open)
neko_pids() {
  local pid
  for pid in $(pgrep -f -- "$NEKO_PATH/bin/neko-launch-shell\$|-p $NEKO_PATH/shell\$|--watch $NEKO_PATH/shell/plugins/"); do
    if (( pid != $$ )); then
      echo "$pid"
    fi
  done
}

# Blur, layer rules and keys from default/hypr/neko.lua. Runtime only:
# `hyprctl reload` restores your config, unless it loads neko.lua itself.
load_hyprland_rules() {
  hyprctl eval "dofile('$NEKO_PATH/default/hypr/neko.lua')" > /dev/null
}

start() {
  if [[ -n $(neko_pids) ]]; then
    echo "neko-shell is already running"
    load_hyprland_rules
    return
  fi

  ensure_theme
  ensure_background

  if [[ -n $NEKO_REPLACES ]]; then
    eval "$NEKO_REPLACES"
  fi

  # Launch through Hyprland so the shell outlives this command, like any autostarted shell
  local launch="env NEKO_PATH=$NEKO_PATH NEKO_QUICKSHELL=${NEKO_QUICKSHELL:-quickshell} PATH=$NEKO_PATH/bin:\$PATH neko-launch-shell"
  hyprctl dispatch "hl.dsp.exec_cmd(\"$launch\")" > /dev/null
  load_hyprland_rules
  echo "neko-shell started"
}

stop() {
  local pids=$(neko_pids)
  if [[ -n $pids ]]; then
    kill $pids 2> /dev/null
  fi

  hyprctl reload > /dev/null

  if [[ -n $NEKO_RESTORES ]]; then
    eval "$NEKO_RESTORES"
  fi
  echo "neko-shell stopped"
}

case $1 in
  start) start ;;
  stop) stop ;;
  theme) apply_theme ;;
  *)
    echo "Usage: neko-session <start|stop|theme>" >&2
    exit 1
    ;;
esac
