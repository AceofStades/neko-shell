#!/bin/bash

# neko:summary=How bright the screen is behind and just below the bar, from 0 (black) to 1 (white)
# neko:args=[bar height]
# neko:hidden=true

# The bar's glass deepens over something bright, so its white text stays
# readable over a light wallpaper or a light page alike. This samples the
# top of the focused display, scaled right down (a few hundred pixels in
# all): the bar's own strip, which the pills sit on, and the band below it,
# which the island's cards and the panels drop over. It prints the brighter
# of the two means. The shell asks only while the island rests and no panel
# is open, so its own glass is no more than the small pills in the strip.

height=${1:-40}
[[ $height =~ ^[0-9]+$ ]] || height=40
read -r x y width < <(hyprctl monitors -j 2> /dev/null | jq -r '.[] | select(.focused) | "\(.x) \(.y) \(.width / .scale | floor)"')
[[ -n $width ]] || exit 1

mean() {
  grim -g "$1" -s 0.05 -t ppm - 2> /dev/null | magick ppm:- -colorspace Gray -format "%[fx:mean]" info: 2> /dev/null
}

strip=$(mean "$x,$y ${width}x$height")
band=$(mean "$x,$((y + height)) ${width}x260")
awk -v a="${strip:-0}" -v b="${band:-0}" 'BEGIN { printf "%.3f\n", (a > b ? a : b) }'
