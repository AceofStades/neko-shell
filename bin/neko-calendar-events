#!/bin/bash

# neko:summary=Print the events of the calendars in ~/.config/neko/calendars as JSON
# neko:args=--from YYYY-MM-DD --to YYYY-MM-DD [--force]
# neko:hidden=true

# neko-core's calendar-events (core/), or, until that's built, the Python
# version it replaces (legacy/)
root=$(cd "$(dirname "$(readlink -f "$0")")/.." && pwd)
if [[ -x $root/core/target/release/neko-core ]]; then
  exec "$root/core/target/release/neko-core" calendar-events "$@"
fi
exec "$root/legacy/neko-calendar-events" "$@"
