#!/bin/bash

# neko:summary=Read and change neko's settings (what the Settings menu uses)
# neko:args=<get|is|set|toggle> <key> [value] | json
# neko:examples=neko-settings set colors material|neko-settings set bar.style attached|neko-settings toggle bar.capsules|neko-settings is app.btop on

# Keys:
#   colors        material (from the wallpaper) | neko (the fixed palette)
#   bar.style     docked | floating | attached  (docked along the edge; floating
#                 off it, every group a pill; or every group hanging from the
#                 top edge, flat-topped)
#   bar.float     on | off  (floating or attached, rather than docked)
#   bar.capsules  on | off  (pill behind each bar widget)
#   app.<name>    on | off  (kitty, btop, tmux or gtk follows the theme)
#
# Bar settings are overrides in ~/.config/neko/shell.toml, which the shell
# watches live; turning a setting back to the theme's choice removes the override.
# The bar's style also lives in shell.json's bar section (floating or attached).

env_file=$HOME/.config/neko/env
overrides=$HOME/.config/neko/shell.toml
layout=$HOME/.config/neko/shell.json
state=$HOME/.local/state/neko/current

if [[ -f $env_file ]]; then
  set -a
  source "$env_file"
  set +a
fi

# A key = value line in a [section] of the overrides file
toml_get() {
  local section=$1 key=$2
  [[ -f $overrides ]] || return 0
  awk -v section="[$section]" -v key="$key" '
    /^\[/ { in_section = ($0 == section); next }
    in_section && $1 == key { sub(/^[^=]*=[[:space:]]*/, ""); print; exit }
  ' "$overrides"
}

toml_set() {
  local section=$1 key=$2 value=$3
  mkdir -p "$(dirname "$overrides")"
  touch "$overrides"
  awk -v section="[$section]" -v key="$key" -v value="$value" '
    /^\[/ {
      if (in_section && !done) { print key " = " value; done = 1 }
      in_section = ($0 == section)
      if (in_section) seen = 1
    }
    in_section && $1 == key { if (!done) print key " = " value; done = 1; next }
    { print }
    END {
      if (!seen) print "\n" section
      if (!done) print key " = " value
    }
  ' "$overrides" > "$overrides.tmp" && mv "$overrides.tmp" "$overrides"
}

toml_unset() {
  local section=$1 key=$2
  [[ -f $overrides ]] || return 0
  awk -v section="[$section]" -v key="$key" '
    /^\[/ { in_section = ($0 == section) }
    !(in_section && $1 == key) { print }
  ' "$overrides" > "$overrides.tmp" && mv "$overrides.tmp" "$overrides"
}

# The bar's style in shell.json, making the user's copy of it if there's none
layout_style() {
  local file=$layout
  [[ -f $file ]] || file=$NEKO_PATH/config/neko/shell.json
  jq -r '.bar.style // "floating"' "$file" 2> /dev/null
}

set_layout_style() {
  if [[ ! -f $layout ]]; then
    mkdir -p "$(dirname "$layout")"
    cp "$NEKO_PATH/config/neko/shell.json" "$layout"
  fi
  jq --indent 2 --arg style "$1" '.bar.style = $style' "$layout" > "$layout.tmp" && mv "$layout.tmp" "$layout"
}

themed_apps() {
  echo "${NEKO_THEME_APPS:-}"
}

set_themed_apps() {
  local apps=$1
  if grep -q '^NEKO_THEME_APPS=' "$env_file" 2> /dev/null; then
    sed -i "s/^NEKO_THEME_APPS=.*/NEKO_THEME_APPS=\"$apps\"/" "$env_file"
  else
    printf '\n# Apps that follow neko'"'"'s theme\nNEKO_THEME_APPS="%s"\n' "$apps" >> "$env_file"
  fi
}

get() {
  case $1 in
    colors)
      cat "$state/theme.name" 2> /dev/null
      ;;
    bar.float)
      # The bar docks unless an override gives it a margin to float on
      local margin
      margin=$(toml_get bar float-margin)
      (( ${margin:-0} > 0 )) && echo on || echo off
      ;;
    bar.style)
      local margin
      margin=$(toml_get bar float-margin)
      if (( ${margin:-0} <= 0 )); then
        echo docked
      elif [[ $(layout_style) == "attached" ]]; then
        echo attached
      else
        echo floating
      fi
      ;;
    bar.capsules)
      [[ $(toml_get bar capsule-alpha) == "0" ]] && echo off || echo on
      ;;
    app.*)
      [[ " $(themed_apps) " == *" ${1#app.} "* ]] && echo on || echo off
      ;;
    *)
      echo "Unknown setting: $1" >&2
      exit 1
      ;;
  esac
}

set_value() {
  local key=$1 value=$2
  case $key in
    colors)
      case $value in
        material) neko-theme-material > /dev/null ;;
        *)
          echo "$value" > "$state/theme.name"
          neko-session theme > /dev/null
          ;;
      esac
      ;;
    bar.float)
      if [[ $value == "on" ]]; then
        toml_set bar float-margin 6
      else
        toml_unset bar float-margin
      fi
      ;;
    bar.style)
      case $value in
        docked)
          # Remember the margin it floated on, for coming back to it
          local margin
          margin=$(toml_get bar float-margin)
          (( ${margin:-0} > 0 )) && toml_set bar float-margin-saved "$margin"
          toml_unset bar float-margin
          set_layout_style floating
          ;;
        floating | attached)
          # Keep the margin the bar floats on, or bring back the last one
          local margin
          margin=$(toml_get bar float-margin)
          if (( ${margin:-0} <= 0 )); then
            margin=$(toml_get bar float-margin-saved)
            toml_set bar float-margin "${margin:-6}"
          fi
          set_layout_style "$value"
          ;;
        *)
          echo "bar.style is docked, floating or attached" >&2
          exit 1
          ;;
      esac
      ;;
    bar.capsules)
      # Capsules sit on a clear bar; without them the bar needs its own background
      if [[ $value == "off" ]]; then
        toml_set bar capsule-alpha 0
        toml_set bar background-alpha 0.55
      else
        toml_unset bar capsule-alpha
        toml_unset bar background-alpha
      fi
      ;;
    app.*)
      local app=${key#app.} apps
      apps=" $(themed_apps) "
      apps=${apps// $app / }
      if [[ $value == "on" ]]; then
        apps="$apps $app"
        set_themed_apps "$(echo $apps)"
        neko-theme-apps "$app"
      else
        set_themed_apps "$(echo $apps)"
        neko-theme-apps --remove "$app"
      fi
      ;;
    *)
      echo "Unknown setting: $key" >&2
      exit 1
      ;;
  esac
}

# Everything the settings window shows, in one read
json() {
  local layout=$HOME/.config/neko/shell.json agents=()
  [[ -f $layout ]] || layout=$NEKO_PATH/config/neko/shell.json
  for agent in claude codex opencode pi crush grok copilot cursor-agent; do
    command -v "$agent" > /dev/null && agents+=("$agent")
  done

  jq -n \
    --arg colors "$(get colors)" \
    --arg float "$(get bar.float)" \
    --arg style "$(get bar.style)" \
    --arg capsules "$(get bar.capsules)" \
    --arg position "$(jq -r '.bar.position // "top"' "$layout" 2> /dev/null)" \
    --arg rotation "$(cat "$HOME/.config/neko/wallpaper-rotation" 2> /dev/null)" \
    --arg apps "$(themed_apps)" \
    --arg agent "$(neko-default-agent 2> /dev/null)" \
    --arg agents "${agents[*]}" \
    '{
      colors: $colors,
      barFloat: ($float == "on"),
      barStyle: $style,
      barCapsules: ($capsules == "on"),
      barPosition: $position,
      rotation: (if $rotation == "" then "off" else $rotation end),
      apps: ($apps | split(" ") | map(select(. != ""))),
      agent: $agent,
      agents: ($agents | split(" ") | map(select(. != "")))
    }'
}

case $1 in
  json) json ;;
  get) get "$2" ;;
  is)
    value=$(get "$2") || exit 1
    [[ $value == "$3" ]]
    ;;
  set) set_value "$2" "$3" ;;
  toggle)
    if [[ $(get "$2") == "on" ]]; then
      set_value "$2" off
    else
      set_value "$2" on
    fi
    ;;
  *)
    echo "Usage: neko-settings <get|is|set|toggle> <key> [value]" >&2
    exit 1
    ;;
esac
