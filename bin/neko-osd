#!/bin/bash

# neko:summary=Show the Neko Quickshell on-screen display
# neko:args=[-i|--icon <icon>] [-m|--message <text>] [-p|--progress <value>] [--max <value>] [--label <text>] [-d|--duration <ms>]
# neko:examples=neko osd -i brightness -p 50 | neko osd -i brightness -p 34 --max 64 --label 8.2 | neko osd -m "Hello"

set -euo pipefail

icon=""
message=""
progress=""
progress_text=""
max="100"
duration=""

while (($#)); do
  case $1 in
    -i|--icon) icon="${2:-}"; shift 2 ;;
    -m|--message) message="${2:-}"; shift 2 ;;
    -p|--progress) progress="${2:-}"; shift 2 ;;
    --max) max="${2:-}"; shift 2 ;;
    --label) progress_text="${2:-}"; shift 2 ;;
    -d|--duration) duration="${2:-}"; shift 2 ;;
    -h|--help) neko osd --help; exit 0 ;;
    *) echo "Unknown OSD option: $1" >&2; exit 1 ;;
  esac
done

# The progress reads as a percentage unless --label gives other text
if [[ -n $progress && -z $progress_text ]]; then
  progress_text="${progress}%"
fi

payload=$(jq -cn \
  --arg icon "$icon" \
  --arg message "$message" \
  --arg value "$progress" \
  --arg progressText "$progress_text" \
  --arg max "$max" \
  --arg duration "$duration" \
  '{icon:$icon,message:$message,value:$value,progressText:$progressText,max:$max,duration:$duration}')

neko-shell -q osd show "$payload"
