#!/bin/bash

# neko:summary=Print the Codex usage record as JSON
# neko:args=[--force] [--limits-only]
# neko:hidden=true

# neko-core's agent-usage-codex (core/), or, until that's built, the Python
# version it replaces (legacy/)
root=$(cd "$(dirname "$(readlink -f "$0")")/.." && pwd)
if [[ -x $root/core/target/release/neko-core ]]; then
  exec "$root/core/target/release/neko-core" agent-usage-codex "$@"
fi
exec "$root/legacy/neko-agent-usage-codex" "$@"
