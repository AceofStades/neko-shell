#!/bin/bash

# neko:summary=Print the Codex usage record as JSON
# neko:args=[--force] [--limits-only]
# neko:hidden=true

# neko-core's agent-usage-codex (core/), which install.sh builds or downloads
root=$(cd "$(dirname "$(readlink -f "$0")")/.." && pwd)
if [[ ! -x $root/core/target/release/neko-core ]]; then
  echo "${0##*/}: neko-core isn't set up; run $root/install.sh, which builds it with Rust or downloads the release build" >&2
  exit 1
fi
exec "$root/core/target/release/neko-core" agent-usage-codex "$@"
