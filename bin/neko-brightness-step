#!/bin/bash

# neko:summary=Step screen brightness along a perceptual curve and show it on the OSD
# neko:args=<up|down|fine-up|fine-down|set <0-64>|get> [--no-osd]
# neko:examples=neko-brightness-step up|neko-brightness-step fine-down|neko-brightness-step set 32|neko-brightness-step get

# 16 steps for the brightness keys, each split into 4 fine steps (64 in all),
# spaced on a gamma 2.5 power curve so every step looks like the same change:
# small at the dark end, larger near full brightness. Each fine step is at
# least one backlight unit above the one before, so none of them is a no-op.
# The shell builds the same curve in shell/services/BrightnessModel.js.
#
# `set` moves straight to a tick and `get` prints the current one, so sliders
# can work on the same 0-64 scale.

usage() {
  echo "Usage: neko-brightness-step <up|down|fine-up|fine-down|set <0-64>|get> [--no-osd]" >&2
  exit 1
}

action=$1
shift
tick=""
if [[ $action == "set" ]]; then
  tick=$1
  shift
  [[ $tick =~ ^[0-9]+$ ]] || usage
fi

osd=1
if [[ $1 == "--no-osd" ]]; then
  osd=0
fi

# How far to move from the current tick; set names its tick instead
delta=0
case $action in
  up) delta=4 ;;
  down) delta=-4 ;;
  fine-up) delta=1 ;;
  fine-down) delta=-1 ;;
  set) ;;
  get) osd=0 ;;
  *) usage ;;
esac

# device,class,current,percent,max
IFS=, read -r _ _ current _ max < <(brightnessctl -m)
if [[ -z $current || -z $max ]]; then
  echo "No backlight found" >&2
  exit 1
fi

read -r step raw < <(awk -v current="$current" -v max="$max" -v delta="$delta" -v tick="$tick" '
  BEGIN {
    steps = 64; gamma = 2.5; floor_value = 1
    previous = 0
    for (i = 0; i <= steps; i++) {
      value = int(((i / steps) ^ gamma) * (max - floor_value) + floor_value + 0.5)
      if (i > 0 && value <= previous) value = previous + 1
      if (value > max) value = max
      curve[i] = value
      previous = value
    }

    # Where the backlight sits now: the closest point on the curve
    nearest = 0
    for (i = 1; i <= steps; i++) {
      if ((curve[i] - current) ^ 2 < (curve[nearest] - current) ^ 2) nearest = i
    }

    # A full step lands on the next whole step that way (8.3 goes up to 9
    # and down to 8); a fine step moves by one
    if (tick != "") target = tick
    else if (delta == 4) target = (int(nearest / 4) + 1) * 4
    else if (delta == -4) target = nearest % 4 ? int(nearest / 4) * 4 : nearest - 4
    else target = nearest + delta
    if (target < 0) target = 0
    if (target > steps) target = steps
    print target, curve[target]
  }
')

if [[ $action == "get" ]]; then
  echo "$step"
  exit 0
fi

brightnessctl -q set "$raw"

# The OSD shows the tick: "8" on a full step, "8.2" two fine steps past it
if (( osd )); then
  label=$(( step / 4 ))
  (( step % 4 )) && label+=".$(( step % 4 ))"
  neko-osd -i brightness -p "$step" --max 64 --label "$label"
fi
