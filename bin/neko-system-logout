#!/bin/bash

# neko:summary=Log out after closing application windows
# neko:examples=neko logout | neko system logout
# neko:aliases=neko logout

nohup bash -c "sleep 2 && uwsm stop" >/dev/null 2>&1 &

neko-osd -i logout -m "Logging out" -d 5000

# Now close all windows
neko-hyprland-window-close-all
sleep 1 # Allow apps like Chrome to shutdown correctly
