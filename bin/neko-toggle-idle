#!/bin/bash

# neko:summary=Toggle idle behavior so the system either idles normally or stays awake
# neko:group=toggle
# neko:args=[toggle|stay-awake|allow-idle|status]
# neko:examples=neko toggle idle | neko toggle idle stay-awake | neko-toggle-idle --status

STATE_DIR="$HOME/.local/state/neko/indicators"
STATE_FILE="$STATE_DIR/stay-awake"

stay_awake_enabled() {
  [[ -f $STATE_FILE ]]
}

print_status() {
  if stay_awake_enabled; then
    printf '{"enabled":true,"class":"enabled","tooltip":"Allow Idle Lock & Screensaver"}\n'
  else
    printf '{"enabled":false,"class":"disabled","tooltip":"Stay Awake"}\n'
  fi
}

print_idle_state() {
  if stay_awake_enabled; then
    printf 'disabled\n'
  else
    printf 'enabled\n'
  fi
}

# A systemd idle inhibitor alongside the flag, so idle daemons outside the
# shell (hypridle honors systemd-inhibit) stay awake too
INHIBITOR_PID="${XDG_RUNTIME_DIR:-/tmp}/neko-stay-awake.pid"

hold_inhibitor() {
  release_inhibitor
  setsid -f systemd-inhibit --what=idle --who=neko --why="Stay awake" sleep infinity > /dev/null 2>&1
  pgrep -n -f '^systemd-inhibit --what=idle --who=neko' > "$INHIBITOR_PID"
}

release_inhibitor() {
  if [[ -f $INHIBITOR_PID ]]; then
    kill "$(cat "$INHIBITOR_PID")" 2> /dev/null
    rm -f "$INHIBITOR_PID"
  fi
}

apply_state() {
  case "$1" in
    stay-awake)
      mkdir -p "$STATE_DIR"
      touch "$STATE_FILE"
      hold_inhibitor
      ;;
    allow-idle)
      rm -f "$STATE_FILE"
      release_inhibitor
      ;;
  esac
}

case "${1:-toggle}" in
  toggle)
    if stay_awake_enabled; then
      apply_state allow-idle
    else
      apply_state stay-awake
    fi
    print_idle_state
    ;;
  stay-awake|awake|on)
    apply_state stay-awake
    print_idle_state
    ;;
  allow-idle|idle|off)
    apply_state allow-idle
    print_idle_state
    ;;
  status|--status)
    print_status
    ;;
  *)
    echo "Usage: neko-toggle-idle [toggle|stay-awake|allow-idle|status]" >&2
    exit 1
    ;;
esac
