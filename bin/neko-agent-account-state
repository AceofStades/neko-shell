#!/bin/bash

# neko:summary=Read and change the registry of Claude, Codex, and Grok subscription accounts
# neko:args=<registry|home|homes|list|refresh|begin|register|use|rename|remove|mode|link|autoswitch> [provider] [args...]
# neko:hidden=true

# neko-core's agent-account-state (core/), or, until that's built, the Python
# version it replaces (legacy/)
root=$(cd "$(dirname "$(readlink -f "$0")")/.." && pwd)
if [[ -x $root/core/target/release/neko-core ]]; then
  exec "$root/core/target/release/neko-core" agent-account-state "$@"
fi
exec "$root/legacy/neko-agent-account-state" "$@"
