# Hyprland global shortcuts the Neko shell registers, one per line: a panel
# plugin to toggle, a volume or brightness key, or an argument-free IPC call
# as target.method. A binding written as o.bind(keys, description,
# { panel = "neko.audio" }), { audio = "raise" }, { brightness = "raise" } or
# { ipc = "media.next" } dispatches the matching shortcut straight to the
# shell, with no process to spawn per keypress. Anything missing here still
# binds, through the neko-shell, neko-audio-output-volume or
# neko-brightness-display command instead.
panel neko.audio
panel neko.bluetooth
panel neko.monitor
panel neko.clock
panel neko.elsewhen
panel neko.network
panel neko.power
panel neko.power-menu
panel neko.capture
panel neko.keybindings
audio raise
audio lower
audio mute-toggle
audio raise-fine
audio lower-fine
brightness raise
brightness lower
ipc media.playPause
ipc media.next
ipc media.previous
ipc notifications.dismissOne
ipc notifications.dismissAll
ipc notifications.invokeLast
ipc notifications.showHistory
