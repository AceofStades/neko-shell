{
  // Neko menu definition.
  // JSONC is used for Neovim-friendly highlighting, comments, and trailing commas.
  // IDs are object keys. Dotted IDs imply hierarchy: trigger.share.file belongs
  // under trigger.share.
  // Kind is inferred: action -> action, target -> link, otherwise submenu.
  // Dotted IDs define the tree. provider:"name" points a submenu at one of
  // the shell's providers (the providers map in shell/plugins/menu/Menu.qml);
  // new provider names cannot be declared here. See docs/menu.md.
  // Optional fields:
  //   aliases        alternate `neko menu summon <name>` routes; also searchable.
  //                  Reserved for established names users already type; new entries
  //                  should not normally add any.
  //   iconFont       font family used for the icon glyph, when it differs from the menu font
  //   title          header text shown when the submenu is open; defaults to label
  //   when           shell condition; hide row when it fails
  //   checked        shell condition; append ✓ when it succeeds
  //   disabled       shell condition; when it succeeds the row stays listed but
  //                  goes dim, takes a ✓ and can no longer be selected. Install
  //                  rows use it so software already on the machine reads as
  //                  installed instead of vanishing from the list.

  "apps": {"icon":"󰀻","label":"Apps","aliases":["app","applications"],"provider":"apps"},

  "learn": {"icon":"󰧑","label":"Learn"},

  "trigger": {"icon":"󱓞","label":"Trigger"},

  "style": {"icon":"","label":"Style"},

  "settings": {"icon":"󰒓","label":"Settings","aliases":["settings","preferences"]},

  "system": {"icon":"","label":"System","aliases":["power-menu"]},
  "system.lock": {"icon":"","label":"Lock","action":"neko-system-lock"},
  "system.suspend": {"icon":"󰒲","label":"Suspend","when":"! neko-toggle-enabled suspend-off","action":"systemctl suspend"},
  "system.hibernate": {"icon":"󰤁","label":"Hibernate","when":"neko-hibernation-available","action":"systemctl hibernate"},
  "system.logout": {"icon":"󰍃","label":"Logout","action":"neko-system-logout"},
  "system.reboot": {"icon":"󰜉","label":"Reboot","action":"neko-system-reboot"},
  "system.shutdown": {"icon":"󰐥","label":"Shutdown","action":"neko-system-shutdown"},

  "learn.keybindings": {"icon":"","label":"Keybindings","action":"neko-menu-keybindings"},
  "learn.hyprland": {"icon":"","label":"Hyprland","action":"neko-launch-webapp 'https://wiki.hypr.land/'"},
  "learn.arch": {"icon":"󰣇","label":"Arch","action":"neko-launch-webapp 'https://wiki.archlinux.org/title/Main_page'"},

  "trigger.emoji": {"icon":"","label":"Emoji","aliases":["emoji","emojis"],"action":"neko-menu-emoji"},
  "trigger.pomodoro": {"icon":"󰔛","label":"Pomodoro","aliases":["pomodoro","focus","timer"],"action":"neko-shell pomodoro toggle"},
  "trigger.capture": {"icon":"","label":"Capture","aliases":["capture","screenshot","screenrecord","screen-record","screenrecording"]},
  "trigger.capture.screenshot": {"icon":"","label":"Screenshot","action":"neko-capture-screenshot"},
  "trigger.capture.screenrecord.stop": {"icon":"","label":"Stop Screenrecording","when":"pgrep -f '^gpu-screen-recorder'","action":"neko-capture-screenrecording --stop-recording"},
  "trigger.capture.screenrecord": {"icon":"","label":"Screenrecord"},
  "trigger.capture.text": {"icon":"󰴑","label":"Text","action":"neko-capture-text"},
  "trigger.capture.qr": {"icon":"󰐲","label":"QR Code","action":"neko-capture-qr"},
  "trigger.capture.color": {"icon":"󰃉","label":"Color","action":"pkill hyprpicker || hyprpicker -a"},
  "trigger.capture.screenrecord.no-audio": {"icon":"","label":"With no audio","action":"neko-capture-screenrecording"},
  "trigger.capture.screenrecord.desktop-audio": {"icon":"","label":"With desktop audio","action":"neko-capture-screenrecording --with-desktop-audio"},
  "trigger.capture.screenrecord.microphone": {"icon":"","label":"With desktop + microphone audio","action":"neko-capture-screenrecording --with-desktop-audio --with-microphone-audio"},
  "trigger.capture.screenrecord.webcam": {"icon":"","label":"With desktop + microphone audio + webcam","when":"neko-hw-webcam","action":"neko-capture-screenrecording-with-webcam"},
  "trigger.share": {"icon":"","label":"Share","aliases":["share"]},
  "trigger.toggle": {"icon":"󰔎","label":"Toggle","aliases":["toggle","toggles"]},
  "trigger.hardware": {"icon":"","label":"Hardware","aliases":["hardware","hw"]},
  "trigger.tests": {"icon":"󰓅","label":"Speed Test"},
  "trigger.hardware.laptop-display": {"icon":"󰛧","label":"Laptop Display","when":"neko-hw-laptop","action":"neko-hyprland-monitor-internal toggle"},
  "trigger.hardware.mirror-display": {"icon":"󰍹","label":"Mirror Display","when":"neko-hw-laptop","action":"neko-hyprland-monitor-internal-mirror toggle"},
  "trigger.share.clipboard": {"icon":"","label":"Clipboard","action":"neko-menu-share clipboard"},
  "trigger.share.file": {"icon":"","label":"File","action":"neko-menu-share file"},
  "trigger.share.folder": {"icon":"","label":"Folder","action":"neko-menu-share folder"},
  "trigger.share.receive": {"icon":"󰥦","label":"Receive","action":"uwsm-app -- localsend"},
  "trigger.toggle.idle-lock": {"icon":"󰅶","label":"Stay Awake","action":"neko-toggle-idle"},
  "trigger.toggle.notifications": {"icon":"󰂛","label":"Notifications","action":"neko-toggle-notification-silencing"},
  "trigger.toggle.top-bar": {"icon":"󰍜","label":"Menu Bar","action":"neko-toggle-bar"},
  "trigger.toggle.battery-percentage": {"icon":"󰁹","label":"Battery Percentage","when":"neko-hw-laptop","action":"neko-shell neko.power togglePercentage"},
  "trigger.tests.network-speedtest": {"icon":"󰓅","label":"Network Speed Test","action":"neko-shell shell summon neko.speedtest"},
  "trigger.tests.disk-speedtest": {"icon":"󰋊","label":"Disk Speed Test","action":"neko-shell shell summon neko.disk-speedtest"},

  "style.theme": {"icon":"󰸌","label":"Theme","aliases":["theme","themes"],"action":"neko-shell shell summon neko.image-picker '{\"source\":\"themes\"}'"},
  "style.wallpaper": {"icon":"󰸉","label":"Wallpaper","aliases":["background","wallpaper"]},
  "style.wallpaper.pick": {"icon":"󰋩","label":"Pick","action":"neko-wallpaper pick"},
  "style.wallpaper.random": {"icon":"󰒝","label":"Random","action":"neko-wallpaper random"},
  "style.wallpaper.rotate": {"icon":"󰁪","label":"Rotate"},
  "style.wallpaper.rotate.off": {"label":"Off","checked":"[[ ! -f ~/.config/neko/wallpaper-rotation ]]","action":"neko-wallpaper auto off"},
  "style.wallpaper.rotate.15": {"label":"Every 15 minutes","checked":"[[ $(cat ~/.config/neko/wallpaper-rotation 2>/dev/null) == 15 ]]","action":"neko-wallpaper auto 15"},
  "style.wallpaper.rotate.30": {"label":"Every 30 minutes","checked":"[[ $(cat ~/.config/neko/wallpaper-rotation 2>/dev/null) == 30 ]]","action":"neko-wallpaper auto 30"},
  "style.wallpaper.rotate.60": {"label":"Every 60 minutes","checked":"[[ $(cat ~/.config/neko/wallpaper-rotation 2>/dev/null) == 60 ]]","action":"neko-wallpaper auto 60"},
  "style.font": {"icon":"","label":"Font","provider":"fonts"},
  "style.bar": {"icon":"󰍜","label":"Menu Bar"},
  "style.bar.position": {"icon":"","label":"Position"},
  "style.bar.transparency": {"icon":"󰂵","label":"Transparency","action":"neko-bar transparent toggle"},
  "style.bar.position.top": {"icon":"󰁝","label":"Top","action":"neko-bar position top"},
  "style.bar.position.bottom": {"icon":"󰁅","label":"Bottom","action":"neko-bar position bottom"},
  "style.bar.position.left": {"icon":"󰁍","label":"Left","action":"neko-bar position left"},
  "style.bar.position.right": {"icon":"󰁔","label":"Right","action":"neko-bar position right"},

  "settings.window": {"icon":"󰖷","label":"Open settings window","action":"neko-shell shell summon neko.settings '{}'"},
  "settings.colors": {"icon":"󰏘","label":"Colors"},
  "settings.colors.material": {"label":"From the wallpaper","checked":"neko-settings is colors material","action":"neko-settings set colors material"},
  "settings.colors.neko": {"label":"Neko (fixed)","checked":"neko-settings is colors neko","action":"neko-settings set colors neko"},
  "settings.bar": {"icon":"󱂩","label":"Bar"},
  "settings.bar.float": {"label":"Floating","checked":"neko-settings is bar.float on","action":"neko-settings toggle bar.float"},
  "settings.bar.capsules": {"label":"Capsules","checked":"neko-settings is bar.capsules on","action":"neko-settings toggle bar.capsules"},
  "settings.apps": {"icon":"󰀻","label":"Themed apps"},
  "settings.apps.gtk": {"label":"GTK apps (Thunar...)","checked":"neko-settings is app.gtk on","action":"neko-settings toggle app.gtk"},
  "settings.apps.btop": {"label":"btop","checked":"neko-settings is app.btop on","action":"neko-settings toggle app.btop"},
  "settings.apps.tmux": {"label":"tmux","checked":"neko-settings is app.tmux on","action":"neko-settings toggle app.tmux"},
  "settings.apps.kitty": {"label":"kitty","checked":"neko-settings is app.kitty on","action":"neko-settings toggle app.kitty"},
  "settings.agent": {"icon":"󰚩","label":"Default agent","aliases":["agent","default-agent"]},
  "settings.agent.claude": {"label":"Claude Code","when":"command -v claude > /dev/null","checked":"[[ $(neko-default-agent) == claude ]]","action":"neko-default-agent claude"},
  "settings.agent.codex": {"label":"Codex","when":"command -v codex > /dev/null","checked":"[[ $(neko-default-agent) == codex ]]","action":"neko-default-agent codex"},
  "settings.agent.opencode": {"label":"OpenCode","when":"command -v opencode > /dev/null","checked":"[[ $(neko-default-agent) == opencode ]]","action":"neko-default-agent opencode"},
  "settings.agent.pi": {"label":"Pi","when":"command -v pi > /dev/null","checked":"[[ $(neko-default-agent) == pi ]]","action":"neko-default-agent pi"},
  "settings.agent.crush": {"label":"Crush","when":"command -v crush > /dev/null","checked":"[[ $(neko-default-agent) == crush ]]","action":"neko-default-agent crush"},
  "settings.agent.grok": {"label":"Grok","when":"command -v grok > /dev/null","checked":"[[ $(neko-default-agent) == grok ]]","action":"neko-default-agent grok"},
  "settings.agent.copilot": {"label":"GitHub Copilot","when":"command -v copilot > /dev/null","checked":"[[ $(neko-default-agent) == copilot ]]","action":"neko-default-agent copilot"},
  "settings.agent.cursor-agent": {"label":"Cursor CLI","when":"command -v cursor-agent > /dev/null","checked":"[[ $(neko-default-agent) == cursor-agent ]]","action":"neko-default-agent cursor-agent"},
}
